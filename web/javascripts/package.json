  },
  "dependencies": {
    "@default/lunr": "npm:lunr@2.3.9",
    "idb-keyval": "^6.2.2",
    "lit-html": "^3.3.0",
    "lunr": "2.3.9",
    "lunr-languages": "^1.14.0"
  },
  "devDependencies": {
    "@types/lunr": "^2.3.7",
    "typescript": "^5.8.3"
  }
}
