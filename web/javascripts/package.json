{
  "name": "@docfx/template",
  "version": "1.0.0",
  "description": "Docfx static website templates",
  "keywords": [
    "docfx",
    "template"
  ],
  "author": "docfx",
  "license": "MIT",
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "build": "node build.js",
    "lint": "eslint modern/src && stylelint modern/src",
